{
  "name": "mini-wolverine-frontend-vue",
  "version": "1.0.0",
  "description": "Vue 3 + Vite + TypeScript frontend for Mini Wolverine financial data demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@primevue/themes": "^4.4.1",
    "monaco-editor": "^0.54.0",
    "pinia": "^2.1.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.9",
    "recharts": "^2.8.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.8",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vue-tsc": "^1.6.5"
  }
}
